<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="quranify"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
      <Icon Value="0"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="KControlsLaz"/>
      </Item>
      <Item>
        <PackageName Value="ATShapeLine_package"/>
      </Item>
      <Item>
        <PackageName Value="lazMapViewerPkg"/>
      </Item>
      <Item>
        <PackageName Value="TurboPowerIPro"/>
      </Item>
      <Item>
        <PackageName Value="atflatcontrols_package"/>
      </Item>
      <Item>
        <PackageName Value="industrial"/>
      </Item>
      <Item>
        <PackageName Value="uEControls"/>
      </Item>
      <Item>
        <PackageName Value="pl_ExControls"/>
      </Item>
      <Item>
        <PackageName Value="pl_Cindy"/>
      </Item>
      <Item>
        <PackageName Value="bgracontrols"/>
      </Item>
      <Item>
        <PackageName Value="rxnew"/>
      </Item>
      <Item>
        <PackageName Value="JvPageCompsR"/>
      </Item>
      <Item>
        <PackageName Value="JvPageCompsD"/>
      </Item>
      <Item>
        <PackageName Value="FrameViewer09"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
      <Item>
        <PackageName Value="indylaz"/>
      </Item>
      <Item>
        <PackageName Value="zcomponentdesign"/>
      </Item>
      <Item>
        <PackageName Value="zcomponent"/>
      </Item>
      <Item>
        <PackageName Value="WebView4Delphi"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="Quranify.lpr"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="quranify"/>
      </Unit>
      <Unit>
        <Filename Value="uq_main.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="MainForm"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="uq_surat.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FormSurat"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="uq_tema.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FormTema"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="uq_splash.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FormSplash"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="udr_waiting.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="frmWait"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="ui_quiz.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="frmQuiz"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="uq_prompt.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FrmPrompting"/>
        <HasResources Value="True"/>
